{
  "name": "kara-ui-website",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --turbopack -p ${PORT:-4300}",
    "build": "next build",
    "start": "next start -p ${PORT:-4300}",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "next typegen && tsc -p ./tsconfig.json"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-variants": "^3.3.1"
  },
  "devDependencies": {
    "@babel/parser": "^7.29.9",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "~19.2.18",
    "@types/react-dom": "^19.2.3",
    "shiki": "^4.5.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~7.0.2"
  }
}
