{
  "name": "kara-ui-example",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --dev-client",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "expo:prebuild": "yarn workspace @hzblj/kara-expo-plugin build && expo prebuild --clean",
    "clean:native": "rm -rf android ios .expo",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T concurrently \"tsc -p ./tsconfig.ios.json\" \"tsc -p ./tsconfig.android.json\"",
    "icons": "kara-icons ./assets/icons"
  },
  "dependencies": {
    "@expo/ui": "~57.0.18",
    "@gorhom/bottom-sheet": "^5.2.14",
    "@hzblj/kara-ui": "workspace:*",
    "@lodev09/react-native-true-sheet": "3.11.18",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/slider": "5.2.0",
    "@shopify/flash-list": "^2.3.2",
    "expo": "~57.0.22",
    "expo-constants": "~57.0.18",
    "expo-dev-client": "~57.0.19",
    "expo-image": "~57.0.5",
    "expo-linking": "~57.0.10",
    "expo-router": "~57.0.21",
    "expo-splash-screen": "~57.0.9",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.3",
    "expo-system-ui": "~57.0.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@storybook/addon-ondevice-actions": "^10.6.0",
    "@storybook/addon-ondevice-controls": "^10.6.0",
    "@storybook/addon-ondevice-notes": "^10.6.0",
    "@storybook/react-native": "^10.6.0",
    "@types/react": "~19.2.18",
    "storybook": "^10.6.0",
    "typescript": "~7.0.2"
  },
  "expo": {
    "install": {
      "exclude": [
        "typescript",
        "@shopify/flash-list"
      ]
    }
  }
}
