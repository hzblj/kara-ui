# Dependencies
node_modules/

# Yarn (node-modules linker — only the release/plugins are committed)
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnp.*

# Turborepo
.turbo

# Package build output
packages/*/lib/
packages/expo-plugin/build/
packages/native/android/build/
packages/native/android/.gradle/
*.tgz

# Expo
.expo/
expo-env.d.ts
web-build/
dist/

# Native projects of the example app are generated by prebuild
apps/example/ios/
apps/example/android/

# Native secrets
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.orig.*

# Metro
.metro-health-check*

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*

# TypeScript
*.tsbuildinfo

# Editors
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# System
.DS_Store
Thumbs.db

# Env
.env*

# pack-check scratch
.pack-check/
