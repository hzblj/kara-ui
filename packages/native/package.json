{
  "name": "@hzblj/kara-native",
  "version": "0.0.0",
  "description": "The KaraUI Expo native module behind @hzblj/kara-ui: Liquid Glass, scroll edge effect, native countdown, context menu, tooltip, navigation bar and SwiftUI/Compose modifiers.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/kara-ui.git",
    "directory": "packages/native"
  },
  "bugs": {
    "url": "https://github.com/hzblj/kara-ui/issues"
  },
  "homepage": "https://github.com/hzblj/kara-ui/tree/main/packages/native#readme",
  "keywords": [
    "react-native",
    "expo",
    "kara-ui"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./swift-ui": {
      "source": "./src/swift-ui/index.ts",
      "types": "./lib/typescript/swift-ui/index.d.ts",
      "default": "./lib/module/swift-ui/index.js"
    },
    "./jetpack-compose": {
      "source": "./src/jetpack-compose/index.ts",
      "types": "./lib/typescript/jetpack-compose/index.d.ts",
      "default": "./lib/module/jetpack-compose/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "expo-module.config.json",
    "ios",
    "android",
    "!android/build/**",
    "!android/.gradle/**",
    "!ios/build/**",
    "!**/*.stories.tsx",
    "!**/contract.check.ts",
    "!**/story-decorators.tsx",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build && tsc -p ./tsconfig.build.json && node ../../scripts/fallback-declarations.mjs",
    "clean": "rm -rf lib",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T concurrently \"tsc -p ./tsconfig.ios.json\" \"tsc -p ./tsconfig.android.json\""
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/__tests__/**,**/__fixtures__/**,**/__mocks__/**,**/*.stories.tsx,**/contract.check.ts,**/story-decorators.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ]
    ]
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.0",
    "expo": "~57.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@expo/ui": "~57.0.18",
    "@types/react": "~19.2.18",
    "expo": "~57.0.22",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.0",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
