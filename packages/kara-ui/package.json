{
  "name": "@hzblj/kara-ui",
  "version": "0.20.1",
  "description": "A native-first design system for Expo: real SwiftUI and Jetpack Compose views through @expo/ui, styled by one token-typed sx engine.",
  "author": "Jan Blazej",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hzblj/kara-ui.git",
    "directory": "packages/kara-ui"
  },
  "bugs": {
    "url": "https://github.com/hzblj/kara-ui/issues"
  },
  "homepage": "https://www.kara.janblazej.dev",
  "keywords": [
    "react-native",
    "expo",
    "expo-ui",
    "swiftui",
    "jetpack-compose",
    "design-system",
    "ui-kit",
    "components",
    "liquid-glass",
    "material-3",
    "material-you",
    "theme",
    "tokens"
  ],
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./header": {
      "source": "./src/header.ts",
      "types": "./lib/typescript/header.d.ts",
      "default": "./lib/module/header.js"
    },
    "./router": {
      "source": "./src/router.ts",
      "types": "./lib/typescript/router.d.ts",
      "default": "./lib/module/router.js"
    },
    "./swift-ui": {
      "source": "./src/swift-ui.ts",
      "types": "./lib/typescript/swift-ui.d.ts",
      "default": "./lib/module/swift-ui.js"
    },
    "./jetpack-compose": {
      "source": "./src/jetpack-compose.ts",
      "types": "./lib/typescript/jetpack-compose.d.ts",
      "default": "./lib/module/jetpack-compose.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "app.plugin.js",
    "bin",
    "!**/*.stories.tsx",
    "!**/contract.check.ts",
    "!**/story-decorators.tsx",
    "!**/__tests__"
  ],
  "scripts": {
    "build": "bob build && tsc -p ./tsconfig.build.json && node ../../scripts/fallback-declarations.mjs",
    "clean": "rm -rf lib",
    "prepack": "yarn run -T turbo run build --filter=$npm_package_name...",
    "lint": "yarn run -T concurrently \"yarn biome:check\" \"yarn tsc:check\"",
    "lint:fix": "yarn run -T biome check --write .",
    "biome:check": "yarn run -T biome check .",
    "tsc:check": "yarn run -T concurrently \"tsc -p ./tsconfig.ios.json\" \"tsc -p ./tsconfig.android.json\""
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "exclude": "{**/__tests__/**,**/__fixtures__/**,**/__mocks__/**,**/*.stories.tsx,**/contract.check.ts,**/story-decorators.tsx}",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ]
    ]
  },
  "dependencies": {
    "@hzblj/expo-native-icons": "^0.1.0",
    "@hzblj/kara-components": "workspace:^",
    "@hzblj/kara-expo-plugin": "workspace:^",
    "@hzblj/kara-native": "workspace:^",
    "@hzblj/kara-router": "workspace:^",
    "@hzblj/kara-sx": "workspace:^",
    "@hzblj/kara-theme": "workspace:^"
  },
  "peerDependencies": {
    "@expo/ui": "~57.0.0",
    "@lodev09/react-native-true-sheet": ">=3.11.0",
    "expo": "~57.0.0",
    "expo-image": "*",
    "expo-router": "*",
    "react": "*",
    "react-native": "*",
    "react-native-reanimated": ">=4.0.0",
    "react-native-safe-area-context": "*",
    "react-native-screens": "*",
    "react-native-worklets": "*"
  },
  "peerDependenciesMeta": {
    "expo-router": {
      "optional": true
    },
    "react-native-safe-area-context": {
      "optional": true
    },
    "react-native-screens": {
      "optional": true
    }
  },
  "devDependencies": {
    "@expo/ui": "~57.0.18",
    "@lodev09/react-native-true-sheet": "3.11.18",
    "@types/react": "~19.2.18",
    "expo": "~57.0.22",
    "expo-image": "~57.0.5",
    "expo-router": "~57.0.21",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-builder-bob": "^0.43.0",
    "react-native-reanimated": "4.5.1",
    "react-native-worklets": "0.10.1",
    "typescript": "~7.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "kara-icons": "./bin/kara-icons.js"
  }
}
